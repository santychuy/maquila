{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "oxc", "unicorn", "import", "node", "promise"],
  "categories": {
    "correctness": "error",
    "suspicious": "error"
  },
  "env": {
    "node": true
  },
  "ignorePatterns": ["dist/**", "node_modules/**", ".maquila/**"],
  "overrides": [
    {
      "files": ["test/**/*.ts"],
      "rules": {
        "typescript/no-floating-promises": "off",
        "typescript/no-unsafe-type-assertion": "off"
      }
    }
  ]
}
