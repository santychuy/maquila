{
  "name": "software-factory",
  "version": "0.1.0",
  "private": true,
  "bin": {
    "factory": "./dist/factory"
  },
  "type": "module",
  "scripts": {
    "build": "bun run build:js && bun run build:binary",
    "build:js": "tsc",
    "build:binary": "bun build ./src/cli.ts --compile --outfile ./dist/factory",
    "lint": "oxlint --type-aware --deny-warnings .",
    "lint:fix": "oxlint --type-aware --fix .",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "test": "bun run build:js && node --test dist/test/*.test.js",
    "check": "bun run lint && bun run format:check && tsc --noEmit && bun run test && bun run build:binary && ./dist/factory --help >/dev/null",
    "factory": "./dist/factory",
    "prepare": "husky"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "0.84.2",
    "typebox": "1.3.7"
  },
  "devDependencies": {
    "@types/node": "24.12.4",
    "husky": "9.1.7",
    "lint-staged": "16.4.0",
    "oxfmt": "0.63.0",
    "oxlint": "1.78.0",
    "oxlint-tsgolint": "7.0.2001",
    "typescript": "5.9.3"
  },
  "engines": {
    "bun": ">=1.3.14",
    "node": ">=22.19.0"
  },
  "packageManager": "bun@1.3.14",
  "trustedDependencies": []
}
