{
  "name": "@santychuy/maquila",
  "version": "0.1.0",
  "description": "A local, guarded Linear-to-pull-request software factory.",
  "homepage": "https://github.com/santychuy/maquila#readme",
  "bugs": {
    "url": "https://github.com/santychuy/maquila/issues"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/santychuy/maquila.git"
  },
  "bin": {
    "maquila": "./dist/src/cli/index.js"
  },
  "files": [
    "dist/src/**/*.js",
    "dist/src/**/*.d.ts",
    "dist/runtime/",
    "src/agents/*.md",
    ".pi/skills/maquila/SKILL.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "README.md",
    "ARCHITECTURE.md",
    "docs/"
  ],
  "type": "module",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "bun run build:observer && bun run build:js && bun run build:binary",
    "build:js": "tsc",
    "build:runtime": "bun scripts/build-runtime.ts",
    "build:package": "bun run build:observer && bun run build:js && bun run build:runtime",
    "prepack": "bun run build:package",
    "check:package": "bun scripts/check-package.ts",
    "build:binary": "bun build ./src/cli/index.ts --compile --outfile ./dist/maquila",
    "lint": "oxlint --type-aware --deny-warnings .",
    "lint:fix": "oxlint --type-aware --fix .",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "test": "bun run build:observer && bun run build:js && node --test dist/test/*.test.js",
    "check": "bun run lint && bun run format:check && bun run build:observer && tsc --noEmit && git diff --exit-code -- src/observer/bundle.generated.ts && bun run test && bun run build:binary && ./dist/maquila --help >/dev/null",
    "maquila": "./dist/maquila",
    "prototype:setup": "bun scripts/prototype-setup-happy-path.ts",
    "e2e:live": "bun scripts/e2e-live-happy-path.ts",
    "prepare": "husky",
    "build:observer": "bun scripts/build-observer-ui.ts"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "0.84.2",
    "dayjs": "1.11.23",
    "preact": "10.29.8",
    "typebox": "1.3.7"
  },
  "devDependencies": {
    "@types/node": "24.12.4",
    "husky": "9.1.7",
    "lint-staged": "16.4.0",
    "oxfmt": "0.63.0",
    "oxlint": "1.78.0",
    "oxlint-tsgolint": "7.0.2001",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "packageManager": "bun@1.3.14",
  "trustedDependencies": []
}
